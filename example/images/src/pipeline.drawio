<mxfile host="drawio">
  <diagram id="pipeline" name="Page-1">
    <mxGraphModel dx="800" dy="300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="data" value="Données&lt;br&gt;étiquetées" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dedede;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="110" height="80" as="geometry"/>
