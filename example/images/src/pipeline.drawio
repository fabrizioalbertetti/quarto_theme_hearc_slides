          </mxCell>
        </object>
        <object label="" id="e1" fragment="1">
          <mxCell style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;" edge="1" parent="1" source="data" target="train">
            <mxGeometry relative="1" as="geometry"/>
          </mxCell>
        </object>
        <object label="Modèle" id="model" fragment="2">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff0000;strokeWidth=2;fontColor=#ff0000;fontStyle=1;fontSize=14;" vertex="1" parent="1">
            <mxGeometry x="400" y="50" width="120" height="60" as="geometry"/>
          </mxCell>
        </object>
        <object label="" id="e2" fragment="2">
          <mxCell style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;" edge="1" parent="1" source="train" target="model">
            <mxGeometry relative="1" as="geometry"/>
