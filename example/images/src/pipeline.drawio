        <object label="à entraîner…" id="todo" fragment-out="2">
          <mxCell style="text;html=1;strokeColor=none;fillColor=none;fontColor=#6e6e6e;fontSize=13;fontStyle=2;align=center;" vertex="1" parent="1">
            <mxGeometry x="400" y="65" width="120" height="30" as="geometry"/>
          </mxCell>
        </object>
        <object label="erreur élevée" id="err" fragment="1" fragment-out="2">
